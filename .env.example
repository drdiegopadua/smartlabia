# Banco de dados
DATABASE_URL="postgresql://user:password@localhost:5432/smartlabia"

# IA: "claude" (producao) ou "gemini" (testes sem custo — use APENAS dados ficticios,
# pois o plano gratuito do Google pode usar o conteudo para melhorar produtos deles)
LLM_PROVIDER="claude"

# Anthropic (Claude)
ANTHROPIC_API_KEY="sk-ant-..."
CLAUDE_MODEL="claude-sonnet-5"

# Google Gemini (so precisa se LLM_PROVIDER="gemini"; chave gratis em aistudio.google.com)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN="EAAG..."
WHATSAPP_PHONE_NUMBER_ID="123456789012345"
WHATSAPP_VERIFY_TOKEN="escolha-um-token-secreto-para-o-webhook"
WHATSAPP_BUSINESS_ACCOUNT_ID="123456789012345"
WHATSAPP_APP_SECRET="app-secret-encontrado-em-Configuracoes-Basicas-do-app-Meta"

# Laboratorio
LAB_NAME="Laboratorio Exemplo"
LAB_TAGLINE="Diagnostico de confianca"
LAB_CITY_UF="Afonso Claudio, ES"
LAB_PHONE="(27) 99898-0658"
LAB_RESULTS_URL="https://exemplo.com.br/resultados"
LAB_TIMEZONE="America/Sao_Paulo"

# Descontos aplicados no orcamento (PDF e texto)
DISCOUNT_PIX_DEBIT=0.40
DISCOUNT_CREDIT_CARD=0.35
MAX_INSTALLMENTS=10

# Servidor
PORT=3000

# Job de reengajamento de leads inativos
FOLLOWUP_CRON="0 * * * *"
FOLLOWUP_INACTIVITY_HOURS=24

# Token para proteger o chat de treinamento da IA (POST /admin/chat).
# Gere um valor aleatorio longo e mantenha em segredo — quem tiver esse token
# pode alterar precos e dados do laboratorio pelo chat.
ADMIN_API_TOKEN="troque-por-um-valor-aleatorio-longo-e-secreto"
